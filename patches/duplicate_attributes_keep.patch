+// Names repeated within one file keep every copy as name_1, name_2, ...
+// Names that occur once stay unchanged.
+inline vector<Attribute> renameRepeatedAttributes(vector<Attribute> attributes) {
+	unordered_map<string, int> total;
+	for (auto& attribute : attributes) {
+		total[attribute.name]++;
+	}
+
+	unordered_map<string, int> seen;
+	for (auto& attribute : attributes) {
+		if (total[attribute.name] > 1) {
+			string name = attribute.name;
+			attribute.name = name + "_" + to_string(++seen[name]);
+		}
+	}
+
+	return attributes;
+}
