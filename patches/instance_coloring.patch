+	// file format: "source <attribute>", "target <attribute>", "ground <id>", then one "<instance id> <colour id>" per line
+	vector<InstanceColoring> loadInstanceColorings(vector<string> paths) {
+		vector<InstanceColoring> colorings;
+
+		for (auto& path : paths) {
+			InstanceColoring coloring;
+			std::ifstream file(path);
+			string key;
+
+			if (!file) {
+				logger::ERROR("could not read instance coloring file " + path);
+				exit(123);
+			}
+
+			while (file >> key) {
+				if (key == "source") {
+					file >> coloring.source;
+				} else if (key == "target") {
+					file >> coloring.target;
+				} else if (key == "ground") {
+					file >> coloring.groundId;
+				} else {
+					int64_t colorId;
+					file >> colorId;
+					coloring.colorIds[std::stoll(key)] = uint16_t(colorId);
+				}
+			}
+
+			if (coloring.source.empty() || coloring.target.empty()) {
+				logger::ERROR("instance coloring file needs a source and a target: " + path);
+				exit(123);
+			}
+
+			colorings.push_back(coloring);
+		}
+
+		return colorings;
+	}
